@model E_Learning.ViewModel.SpeakingExercisePageViewModel

@{
    ViewData["Title"] = "Speaking Practice";
}

<div class="container mt-4">

    <h2 class="fw-bold mb-4">Speaking Practice</h2>

    @foreach (var part in Model.Parts)
    {
        <div class="mb-5">
            
            <h4 class="fw-bold text-primary mb-3">
                Part @part.Part
            </h4>

            @foreach (var topic in part.Topics)
            {
                <div class="card mb-4 shadow-sm">

                    <div class="card-header fw-bold">
                        @topic.Title
                    </div>

                    <div class="card-body">

                        @foreach (var q in topic.Questions.OrderBy(x => x.OrderNumber))
                        {
                            <div class="mb-4">

                                <p class="fw-bold mb-2">
                                    @q.QuestionText
                                </p>

                                @if (!string.IsNullOrWhiteSpace(q.AudioUrl))
                                {
                                    <audio controls class="w-100 mb-2">
                                        <source src="@q.AudioUrl" type="audio/mpeg" />
                                    </audio>
                                }
                                <form asp-action="SubmitSpeaking"
                                      method="post"
                                      class="mt-2">

                                    <input type="hidden" name="ExerciseId" value="@topic.ExerciseId" />

                                    <div class="mb-2">
                                        <label class="form-label">
                                            Audio trả lời (URL)
                                        </label>
                                        <input type="text"
                                               name="AudioFileUrl"
                                               class="form-control"
                                               placeholder="https://your-audio-url.mp3"
                                               required />
                                    </div>

                                    <button type="submit"
                                            class="btn btn-outline-primary btn-sm">
                                        Nộp câu trả lời
                                    </button>

                                </form>

                            </div>
                        }

                    </div>
                </div>
            }

        </div>
    }

</div>
