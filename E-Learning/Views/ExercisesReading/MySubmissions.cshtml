@model List<E_Learning.ViewModel.MySubmissionItemViewModel>

@{
    ViewData["Title"] = "Lịch sử bài đọc";
}

<div class="container mt-4">

    <h2 class="fw-bold mb-4">Lịch sử bài đọc</h2>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            Bạn chưa làm bài đọc nào.
        </div>
    }
    else
    {
        <table class="table table-bordered table-hover align-middle">

            <thead class="table-light">
                <tr>
                    <th>Bài đọc</th>
                    <th>Điểm</th>
                    <th>Ngày nộp</th>
                    <th class="text-center">Chi tiết</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.ExerciseTitle</td>

                        <td>
                            @if (item.TotalScore >= 60)
                            {
                                <span class="badge bg-success">
                                    @item.TotalScore
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger">
                                    @item.TotalScore
                                </span>
                            }
                        </td>

                        <td>
                            @item.SubmittedAt.ToLocalTime()
                        </td>

                        <td class="text-center">
                            <a asp-action="Result"
                               asp-route-submissionId="@item.SubmissionId"
                               class="btn btn-sm btn-outline-primary">
                                Xem
                            </a>
                        </td>
                    </tr>
                }
            </tbody>

        </table>
    }

    <div class="mt-3">
        <a asp-action="Index"
           class="btn btn-outline-secondary">
            Quay lại bài đọc
        </a>
    </div>

</div>
