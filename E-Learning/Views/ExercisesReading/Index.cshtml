@model E_Learning.ViewModel.ReadingExerciseViewModel

<h2>@Model.ExerciseTitle</h2>

@if (!string.IsNullOrWhiteSpace(Model.Passage))
{
    <div class="border p-3 mb-4">
        @Html.Raw(Model.Passage)
    </div>
}

<form asp-action="Submit" method="post">
    <input type="hidden" name="ExerciseId" value="@Model.ExerciseId" />

    @foreach (var q in Model.Questions)
    {
        <div class="mb-3">
            <p><strong>@q.QuestionText</strong></p>

            <input class="form-control"
                   name="Answers[@q.QuestionId]"
                   placeholder="Your answer..." />
        </div>
    }

    <button type="submit" class="btn btn-primary">
        Submit
    </button>
</form>
