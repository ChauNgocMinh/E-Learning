@using E_Learning.ViewModel
@model ReadingExerciseViewModel

<h2>@Model.ExerciseTitle</h2>

@if (!string.IsNullOrEmpty(Model.Passage))
{
    <div class="alert alert-light p-3">
        @Html.Raw(Model.Passage)
    </div>
}

<form asp-action="Submit" method="post">
    <input type="hidden" name="ExerciseId" value="@Model.ExerciseId" />

    @foreach (var q in Model.Questions)
    {
        <div class="card mb-3 p-3">
            <h5>Câu @q.OrderNumber: @q.QuestionText</h5>

            @if (!string.IsNullOrEmpty(q.OptionsJson))
            {
                var ops = System.Text.Json.JsonSerializer.Deserialize<List<string>>(q.OptionsJson);

                foreach (var op in ops)
                {
                    <label>
                        <input type="radio" name="Answers[@q.Id]" value="@op" /> @op
                    </label>
        
                    <br />
                }
            }
            else
            {
                <input type="text" class="form-control" name="Answers[@q.Id]" placeholder="Nhập câu trả lời..." />
            }
        </div>
    }

    <button type="submit" class="btn btn-primary">Nộp bài</button>
</form>
