@model E_Learning.ViewModel.SubmissionResultViewModel

@{
    ViewData["Title"] = "Kết quả Listening";
}

<h2>Kết quả bài làm</h2>

<p><strong>Bài:</strong> @Model.ExerciseTitle</p>
<p><strong>Thời gian nộp:</strong> @Model.SubmittedAt.ToString("dd/MM/yyyy HH:mm")</p>
<p><strong>Điểm:</strong> @Model.TotalScore / @Model.TotalQuestions</p>

<hr />

<h4>Chi tiết từng câu</h4>

@foreach (var d in Model.Details)
{
    <div class="card mb-3 p-3 @(d.IsCorrect ? "border-success" : "border-danger")">
        <h5>Câu @d.OrderNumber: @d.QuestionText</h5>

        <p>
            <strong>Đáp án của bạn:</strong>
            <span class="@(d.IsCorrect ? "text-success" : "text-danger")">@d.UserInput</span>
        </p>

        <p>
            <strong>Đáp án đúng:</strong>
            <span class="text-success">@d.CorrectAnswer</span>
        </p>

        @if (!string.IsNullOrEmpty(d.Explanation))
        {
            <p><strong>Giải thích:</strong> @d.Explanation</p>
        }
    </div>
}

<a href="/Exercise/Index" class="btn btn-secondary mt-3">Quay lại danh sách bài tập</a>
