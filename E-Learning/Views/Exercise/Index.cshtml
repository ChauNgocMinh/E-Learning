@using E_Learning.Domain.Entities
@using E_Learning.Domain.Comon
@using E_Learning.Domain.Enums
@model ListPages<Exercise>

@{
    ViewData["Title"] = "Tất cả bài tập";
}

<style>
    .exercise-card-img {
        height: 180px;
        object-fit: cover;
    }
</style>

<div class="container py-4">

    <!-- Header & Search -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <h2 class="fw-bold mb-0">Tất cả bài tập</h2>
        <form method="get" class="d-flex" style="max-width: 300px;">
            <input name="search" class="form-control me-2" type="search" placeholder="Tìm theo tên bài tập" />
            <button class="btn btn-success">Tìm kiếm</button>
        </form>
    </div>

    <div class="row g-4">
        @foreach (var item in Model.Items)
        {
            var skill = item.Skill;
            string skillLabel = skill.ToString();
            string controllerName = skill switch
            {
                SkillType.Listening => "ExercisesListening",
                SkillType.Reading => "ExercisesReading",
                SkillType.Speaking => "ExercisesSpeaking",
                SkillType.Writing => "ExercisesWriting",
                _ => "Exercises"
            };

            string badgeColor = skill switch
            {
                SkillType.Listening => "bg-primary",
                SkillType.Reading => "bg-success",
                SkillType.Speaking => "bg-warning text-dark",
                SkillType.Writing => "bg-danger",
                _ => "bg-secondary"
            };
            <div class="col-sm-6 col-md-4 col-lg-3">
                <div class="card h-100 shadow-sm border-0 rounded-4 overflow-hidden">

                    <div class="position-relative">
                        <img class="card-img-top exercise-card-img"
                             src="@(!string.IsNullOrEmpty(item.ImageUrl) ? item.ImageUrl : "/img/default.jpg")" />

                        <span class="badge @badgeColor position-absolute top-0 start-0 m-2 px-3 py-2 rounded-pill fs-6 shadow-sm">
                            @skillLabel
                        </span>
                    </div>

                    <div class="card-body d-flex flex-column">
                        <h6 class="card-title fw-bold text-truncate mb-1" title="@item.Title">@item.Title</h6>
                        <p class="card-text text-muted small" style="height:40px; overflow:hidden;">
                            @item.Description
                        </p>

                        <div class="mt-auto d-flex justify-content-between align-items-center">
                            <a asp-controller="@controllerName" asp-action="Index" asp-route-exerciseId="@item.Id"
                               class="btn btn-outline-primary btn-sm rounded-pill px-3">
                                Xem chi tiết
                            </a>

                            <span class="badge bg-light text-dark border rounded-pill px-3">
                                <i class="bi bi-activity me-1"></i>@item.AttemptCount lượt làm
                            </span>
                        </div>
                    </div>

                </div>
            </div>
        }
    </div>

    <!-- Pagination -->
    @if (Model.TotalCount > Model.PageSize)
    {
        var totalPages = (int)Math.Ceiling((double)Model.TotalCount / Model.PageSize);

        <nav class="mt-5 d-flex justify-content-center">
            <ul class="pagination">
                <li class="page-item @(Model.Page == 1 ? "disabled" : "")">
                    <a class="page-link" href="?page=@(Model.Page - 1)&pageSize=@Model.PageSize">&laquo;</a>
                </li>

                @for (var i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == Model.Page ? "active" : "")">
                        <a class="page-link" href="?page=@i&pageSize=@Model.PageSize">@i</a>
                    </li>
                }

                <li class="page-item @(Model.Page == totalPages ? "disabled" : "")">
                    <a class="page-link" href="?page=@(Model.Page + 1)&pageSize=@Model.PageSize">&raquo;</a>
                </li>
            </ul>
        </nav>
    }
</div>
