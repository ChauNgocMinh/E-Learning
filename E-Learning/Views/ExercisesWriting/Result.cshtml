@model E_Learning.ViewModel.WritingResultViewModel

<div class="container mt-4">

    <h2 class="fw-bold">@Model.ExerciseTitle</h2>


    <hr />

    <h4>Bài làmm của bạn</h4>

    <div class="border rounded p-3 bg-light mb-3" style="white-space: pre-wrap;">
        @Model.EssayText
    </div>

    <hr />



    <p><strong>Điểm:</strong> @Model.TotalScore / 100</p>
    <p><strong>Ngày nộp:</strong> @Model.SubmittedAt.ToLocalTime()</p>

    <hr />

    <h3>Band Score: @Model.Band</h3>

    <p><b>Task Response:</b> @Model.TaskResponse</p>
    <p><b>Coherence & Cohesion:</b> @Model.CoherenceCohesion</p>
    <p><b>Lexical Resource:</b> @Model.LexicalResource</p>
    <p><b>Grammar:</b> @Model.GrammarRangeAccuracy</p>

    <h4 class="mt-3">Strengths</h4>
    <p>@Model.Strengths</p>

    <h4>Weaknesses</h4>
    <p>@Model.Weaknesses</p>

    <h4>Suggestions</h4>
    <p>@Model.Suggestions</p>

    <div class="mt-4">
        <a asp-action="Index"
           asp-route-exerciseId="@Model.ExerciseId"
           class="btn btn-outline-secondary">
            Làm lại bài
        </a>

        <a asp-action="MySubmissions"
           class="btn btn-outline-primary ms-2">
            Lịch sử bài làm
        </a>
    </div>
</div>
