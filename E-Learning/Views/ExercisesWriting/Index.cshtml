@model E_Learning.ViewModel.WritingExerciseViewModel

@{
    ViewData["Title"] = Model.Title;
}

<div class="container mt-4">

    <h2 class="fw-bold mb-3">@Model.Title</h2>

    <!-- Prompt -->
    <div class="card mb-4">
        <div class="card-body">
            <p class="mb-0">@Model.PromptText</p>
        </div>
    </div>
    @if (!string.IsNullOrWhiteSpace(Model.SampleImageUrl))
    {
        <div class="mb-4 text-center">
            <img src="@Model.SampleImageUrl"
                 class="img-fluid rounded shadow-sm"
                 alt="Writing sample image" />
        </div>
    }
    <form asp-action="SubmitWriting" method="post">

        <input type="hidden" name="ExerciseId" value="@Model.ExerciseId" />

        <div class="mb-3">
            <label class="form-label fw-bold">
                Bài viết của bạn
            </label>
            <textarea name="EssayText"
                      class="form-control"
                      rows="10"
                      placeholder="Nhập bài viết của bạn tại đây..."
                      required></textarea>
        </div>

        <button type="submit"
                class="btn btn-primary btn-lg px-5">
            Nộp bài
        </button>

    </form>

</div>
