@model E_Learning.ViewModel.SubmissionResultViewModel

@{
    ViewData["Title"] = "Kết quả bài làm";
}

<div class="container mt-4">

    <h2 class="fw-bold mb-3">@Model.ExerciseTitle</h2>

    <p>
        <strong>Điểm:</strong>
        @Model.TotalScore / 100
    </p>

    <p>
        <strong>Ngày nộp:</strong>
        @Model.SubmittedAt.ToLocalTime()
    </p>

    <hr />

    @foreach (var q in Model.Details)
    {
        <div class="mb-3 p-3 border rounded">

            <p class="fw-bold">
                Câu @q.OrderNumber: @q.QuestionText
            </p>

            <ul>
                <li>A. @q.Options.A</li>
                <li>B. @q.Options.B</li>
                <li>C. @q.Options.C</li>
                <li>D. @q.Options.D</li>
            </ul>

            <p>
                <strong>Đáp án của bạn:</strong> @q.UserAnswer
            </p>

            <p>
                <strong>Đáp án đúng:</strong> @q.CorrectAnswer
            </p>

            @if (q.IsCorrect)
            {
                <span class="badge bg-success">Đúng</span>
            }
            else
            {
                <span class="badge bg-danger">Sai</span>
            }

            @if (!string.IsNullOrWhiteSpace(q.Explanation))
            {
                <p class="text-muted mt-2">
                    @q.Explanation
                </p>
            }
        </div>
    }
 
    <div class="mt-4">
        <a asp-action="Index"
           asp-route-exerciseId="@Model.ExerciseId"
           class="btn btn-outline-secondary">
            Làm lại bài
        </a>

        <a asp-controller="ExercisesReading"
           asp-action="MySubmissions"
           class="btn btn-outline-primary ms-2">
            Lịch sử bài làm
        </a>
    </div>

</div>
