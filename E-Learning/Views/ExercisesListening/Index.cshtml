@model E_Learning.ViewModel.ListeningExerciseViewModel

@{
    ViewData["Title"] = Model.ExerciseTitle;
}

<div class="container mt-4">

  
    <h2 class="fw-bold mb-3">@Model.ExerciseTitle</h2>

   
    @if (!string.IsNullOrWhiteSpace(Model.AudioUrl))
    {
        <div class="mb-4">
            <audio controls class="w-100">
                <source src="@Model.AudioUrl" type="audio/mpeg" />
                Trình duyệt của bạn không hỗ trợ audio.
            </audio>
        </div>
    }

    <!-- Form -->
    <form asp-action="Submit" method="post">

        <input type="hidden" name="ExerciseId" value="@Model.ExerciseId" />

        @if (Model.Questions == null || !Model.Questions.Any())
        {
            <div class="alert alert-warning">
                Bài nghe hiện chưa có câu hỏi.
            </div>
        }
        else
        {
            <div class="list-group">

                @for (int i = 0; i < Model.Questions.Count; i++)
                {
                    var q = Model.Questions[i];

                    <div class="list-group-item mb-3 shadow-sm p-3">

                        <p class="fw-bold mb-2">
                            Câu @(i + 1). @q.QuestionText
                        </p>

                        <div class="ps-2">
                            <label class="d-block mb-1">
                                <input type="radio"
                                       name="Answers[@q.QuestionId]"
                                       value="A"
                                       required />
                                A. @q.OptionA
                            </label>

                            <label class="d-block mb-1">
                                <input type="radio"
                                       name="Answers[@q.QuestionId]"
                                       value="B" />
                                B. @q.OptionB
                            </label>

                            <label class="d-block mb-1">
                                <input type="radio"
                                       name="Answers[@q.QuestionId]"
                                       value="C" />
                                C. @q.OptionC
                            </label>

                            <label class="d-block mb-1">
                                <input type="radio"
                                       name="Answers[@q.QuestionId]"
                                       value="D" />
                                D. @q.OptionD
                            </label>
                        </div>

                    </div>
                }
            </div>

            <button type="submit"
                    class="btn btn-primary btn-lg mt-4 px-5">
                Nộp bài
            </button>
        }

    </form>

</div>
