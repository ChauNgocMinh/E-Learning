@model E_Learning.ViewModel.ListeningExerciseViewModel

@{
    ViewData["Title"] = "Listening Exercise";
}

<h2>@Model.ExerciseTitle</h2>

@if (!string.IsNullOrEmpty(Model.AudioUrl))
{
    <div class="mt-3 mb-4">
        <audio controls>
            <source src="@Model.AudioUrl" type="audio/mpeg" />
            Trình duyệt không hỗ trợ phát âm thanh.
        </audio>
    </div>
}

<form asp-action="Submit" method="post">
    <input type="hidden" name="ExerciseId" value="@Model.ExerciseId" />

    @foreach (var q in Model.Questions)
    {
        <div class="card mb-3 p-3">
            <h5>Câu @q.OrderNumber: @q.QuestionText</h5>

            <div class="mt-2">
                <label>
                    <input type="radio" name="Answers[@q.Id]" value="A" />
                    A. @q.OptionA
                </label><br />

                <label>
                    <input type="radio" name="Answers[@q.Id]" value="B" />
                    B. @q.OptionB
                </label><br />

                <label>
                    <input type="radio" name="Answers[@q.Id]" value="C" />
                    C. @q.OptionC
                </label><br />

                <label>
                    <input type="radio" name="Answers[@q.Id]" value="D" />
                    D. @q.OptionD
                </label>
            </div>
        </div>
    }

    <button type="submit" class="btn btn-primary">Nộp bài</button>
</form>
